  m_text: "\u0420\u0430\u0434 \u043F\u043E\u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u044E \u043D\u0435\u0447\u0435\u0441\u0442\u044C!
    \u0421\u0430\u043C\u043E\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435?
    \u0423\u043D\u0438\u0436\u0435\u043D\u0438\u0435? \u041D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C
    \u043A\u043E \u0432\u0441\u0435\u043C\u0443?! \u0422\u0410\u041A \u042D\u0422\u041E
    \u042F \u041F\u0420\u0418\u0414\u0423\u041C\u0410\u041B \u042D\u0422\u0418 \u0421\u041B\u041E\u0412\u0410!
    \u0414\u0430\u0432\u0430\u0439 \u0443\u0436\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
    \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0440\u044C\u043C\u0430!
    \u0412\u0441\u0435\u0445 \u0441\u043F\u0430\u0441\u0443 \u0446\u0435\u043D\u043E\u0439
    \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438!"
