--- !u!114 &8200490000000000095
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8200490000000000082}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e8c58d869174ea18ea6e92499ca590a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subject42.Bunker.Gallery.EnemyGalleryController
  enemies:
  - id: basic
    name: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439"
    enemyPrefab: {fileID: 8973031007421530716, guid: 86df554c5e41c0e488ca79d580848906, type: 3}
    demo: 0
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 0}
    description: "\u041F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0446\u0435\u043B\u044C\n\u0432
      \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u0431\u043E\u044E.\n\u041E\u043F\u0430\u0441\u0435\u043D
      \u0432 \u0433\u0440\u0443\u043F\u043F\u0435."
    funFact: "\u041E\u0434\u0438\u043D \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439.\n\u041F\u044F\u0442\u044C
      \u2014 \u0443\u0436\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430."
  - id: elite
    name: "\u042D\u043B\u0438\u0442\u043D\u044B\u0439"
    enemyPrefab: {fileID: 1432338969431510999, guid: bbeab41e755732443b4201b8641136c9, type: 3}
    demo: 1
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 0}
    description: "\u0423\u0441\u0438\u043B\u0435\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F\n\u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u0432\u0440\u0430\u0433\u0430:\n\u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F\n\u0438
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
    funFact: "\u041E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u0442\n\u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430\n\u0442\u0435\u0431\u0435 \u0438 \u0442\u0430\u043A
      \u043F\u043B\u043E\u0445\u043E."
  - id: bomber
    name: "\u0411\u043E\u043C\u0431\u0435\u0440"
    enemyPrefab: {fileID: 1432338969431510999, guid: 46ef0098ace1f0e4585348645e131dff, type: 3}
    demo: 2
    warningPrefab: {fileID: 3431147270733573790, guid: b55be29f2b455a247af6b6c19b37afd7, type: 3}
    explosionPrefab: {fileID: 3932597101254327762, guid: f91913de896646447a357936450e42c5, type: 3}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 1557866962218771819, guid: b8f18a3e8db90c84982afced42fab101, type: 3}
    description: "\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0431\u043B\u0438\u0436\u0435\n\u0438
      \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,\n\u043D\u0430\u043D\u043E\u0441\u044F
      \u0443\u0440\u043E\u043D\n\u043F\u043E \u043E\u0431\u043B\u0430\u0441\u0442\u0438."
    funFact: "\u041B\u0438\u0447\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\n\u0435\u043C\u0443
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430."
  - id: shooter
    name: "\u0421\u0442\u0440\u0435\u043B\u043E\u043A"
    enemyPrefab: {fileID: 2513438768801038890, guid: c234c537ed1fdfe489feaf994e3dbca7, type: 3}
    demo: 3
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 1168613123775889235, guid: 3cd5630d49123414ba68ea2d0d673765, type: 3}
    shockwavePrefab: {fileID: 0}
    description: "\u0410\u0442\u0430\u043A\u0443\u0435\u0442 \u0441 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438\n\u0438
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\n\u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u043C\u0435\u043D\u044F\u0442\u044C\n\u043F\u043E\u0437\u0438\u0446\u0438\u044E."
    funFact: "\u0412 \u0433\u0430\u043B\u0435\u0440\u0435\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442\n\u0432
      \u0441\u0442\u0435\u043D\u0443. \u0422\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435\n\u0432\u0441\u0435\u043C."
  - id: boss
    name: "\u0411\u043E\u0441\u0441"
    enemyPrefab: {fileID: 8074722678228422782, guid: 8f73b608ef0309744b732a66e85e86d7, type: 3}
    demo: 4
    warningPrefab: {fileID: 3431147270733573790, guid: c941bc18f7e086648bae2a23e2a87208, type: 3}
    explosionPrefab: {fileID: 3932597101254327762, guid: f91913de896646447a357936450e42c5, type: 3}
    projectilePrefab: {fileID: 6415994172789663665, guid: 703da712b72d21341ae48974468d51ca, type: 3}
    shockwavePrefab: {fileID: 0}
    description: "\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0443\u0433\u0440\u043E\u0437\u0430\n\u0437\u0430\u0431\u0435\u0433\u0430.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\n\u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0430\u0442\u0430\u043A\n\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    funFact: "\u0414\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u0435\u043C\u0443
      \u0434\u0430\u043B\u0438\n\u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E."
