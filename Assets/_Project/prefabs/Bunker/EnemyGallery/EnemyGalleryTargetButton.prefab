  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e8c58d869174ea18ea6e92499ca590a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Subject42.Bunker.Gallery.EnemyGalleryController
  enemies:
  - id: basic
    name: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439"
    previewPrefab: {fileID: 4564208127306105067, guid: 579c34b8081ae18478bfcccae759346f, type: 3}
    demo: 0
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 0}
    description: "\u041F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0446\u0435\u043B\u044C\n\u0432
      \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u0431\u043E\u044E.\n\u041E\u043F\u0430\u0441\u0435\u043D
      \u0432 \u0433\u0440\u0443\u043F\u043F\u0435."
    funFact: "\u041E\u0434\u0438\u043D \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439.\n\u041F\u044F\u0442\u044C
      \u2014 \u0443\u0436\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430."
  - id: elite
    name: "\u042D\u043B\u0438\u0442\u043D\u044B\u0439"
    previewPrefab: {fileID: 3252002812431456567, guid: 60d6def390a6c7542af3c1ecdf796981, type: 3}
    demo: 1
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 0}
    description: "\u0423\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0439 \u0432\u0440\u0430\u0433:\n\u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F\n\u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
    funFact: "\u041E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u0442\n\u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430\n\u0442\u0435\u0431\u0435 \u0438 \u0442\u0430\u043A
      \u043F\u043B\u043E\u0445\u043E."
  - id: bomber
    name: "\u0411\u043E\u043C\u0431\u0435\u0440"
    previewPrefab: {fileID: 6563272073406911946, guid: a779094970b779044a5c32a390d7b7b5, type: 3}
    demo: 2
    warningPrefab: {fileID: 9139707548086174962, guid: dc2e60313183d674fa0625438e053336, type: 3}
    explosionPrefab: {fileID: 232786880922592030, guid: de24590c87de95c4b82ba2f7e2df726c, type: 3}
    projectilePrefab: {fileID: 0}
    shockwavePrefab: {fileID: 2966997940858966663, guid: e8c4c719ab165234297ef923b9366461, type: 3}
    description: "\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0431\u043B\u0438\u0436\u0435\n\u0438
      \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F:\n\u0443\u0440\u043E\u043D
      \u043F\u043E \u043E\u0431\u043B\u0430\u0441\u0442\u0438."
    funFact: "\u041B\u0438\u0447\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\n\u0435\u043C\u0443
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430."
  - id: shooter
    name: "\u0421\u0442\u0440\u0435\u043B\u043E\u043A"
    previewPrefab: {fileID: 4455286401991097602, guid: e0f7ed3b7c213bd45bb056734e691f39, type: 3}
    demo: 3
    warningPrefab: {fileID: 0}
    explosionPrefab: {fileID: 0}
    projectilePrefab: {fileID: 7043476422243544937, guid: 85afa9bd067f71c4594958f6745a76ee, type: 3}
    shockwavePrefab: {fileID: 0}
    description: "\u0410\u0442\u0430\u043A\u0443\u0435\u0442 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.\n\u0417\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u0435\u043D\u044F\u0442\u044C\n\u043F\u043E\u0437\u0438\u0446\u0438\u044E."
    funFact: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0432 \u0441\u0442\u0435\u043D\u0443.\n\u0422\u0430\u043A
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435\n\u0432\u0441\u0435\u043C."
  - id: boss
    name: "\u0411\u043E\u0441\u0441"
    previewPrefab: {fileID: 5633680299399175147, guid: 9846d650d17bdf24f9b5965f2035e5c2, type: 3}
    demo: 4
    warningPrefab: {fileID: 778829101924748307, guid: 6bb10a55245d19f40b935782da58c40f, type: 3}
    explosionPrefab: {fileID: 232786880922592030, guid: de24590c87de95c4b82ba2f7e2df726c, type: 3}
    projectilePrefab: {fileID: 4088090669412681731, guid: 8aa6e297d535cde44ac94a96a69ae85e, type: 3}
    shockwavePrefab: {fileID: 0}
    description: "\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0443\u0433\u0440\u043E\u0437\u0430.\n\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0430\u0442\u0430\u043A \u2014\n\u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E."
    funFact: "\u0414\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u0435\u043C\u0443
      \u0434\u0430\u043B\u0438\n\u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E."
