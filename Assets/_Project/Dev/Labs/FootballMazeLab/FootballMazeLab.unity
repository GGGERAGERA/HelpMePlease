  - PlayerSpawn: {fileID: 1477098094}
    BallSpawn: {fileID: 335093117}
    Hint: "02 / \u0421\u041C\u0415\u041D\u0410 \u041C\u0410\u0420\u0428\u0420\u0423\u0422\u0410\nB
      \u0437\u0430\u043A\u0440\u043E\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0434
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0412\u0435\u0440\u043D\u0438\u0441\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0438\u0436\u043D\u0438\u0439 \u043E\u0431\u0445\u043E\u0434
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438 \u043C\u044F\u0447 \u0447\u0435\u0440\u0435\u0437
      \u0432\u0435\u0440\u0445\u043D\u044E\u044E \u0434\u0432\u0435\u0440\u044C."
  - PlayerSpawn: {fileID: 1253610978}
    BallSpawn: {fileID: 666582503}
    Hint: "03 / \u0427\u0415\u0420\u0415\u0417 \u0420\u0415\u0428\u0401\u0422\u041A\u0423\n\u0423\u0434\u0430\u0440\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0443\u0437\u043A\u043E\u0435 \u043E\u043A\u043D\u043E
      C. \u041E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0432\u0435\u0440\u0445\u043D\u044F\u044F
      \u0434\u0432\u0435\u0440\u044C \u2014 \u0437\u0430\u0431\u0435\u0440\u0438
      \u043C\u044F\u0447 \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
  - PlayerSpawn: {fileID: 2006423012}
    BallSpawn: {fileID: 1301451076}
    Hint: "04 / \u0420\u0418\u041A\u041E\u0428\u0415\u0422\n\u0421 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0439
      \u043C\u0435\u0442\u043A\u0438 \u0431\u0435\u0439 \u0432 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u0441\u0442\u0435\u043D\u044B. \u041E\u0442\u0441\u043A\u043E\u043A \u043F\u043E\u043F\u0430\u0434\u0451\u0442
