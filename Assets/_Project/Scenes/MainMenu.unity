  m_text: "\u042F \u0442\u043E\u043F \u043C\u0430\u0433! \u0412\u044B\u0435\u0431\u0443
    \u0432\u0441\u0435\u0445, \u0432\u0441\u0435 \u0434\u0435\u043D\u044C\u0433\u0438
    \u043C\u043E\u0438, \u0432\u0441\u0435 \u0434\u0435\u0432\u043A\u0438 \u0442\u043E\u0436\u0435!
    \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043D\u0430 \u0432\u043F\u0438\u0441\u043A\u0435
    \u0437\u0430\u0431\u0440\u0430\u043B \u0443 \u0413\u0435\u0440\u044B \u0432\u0441\u0435\u0445
    \u043D\u044F\u0448\u0435\u043A \u043D\u0430\u043B\u0435\u0433\u043A\u0435 \u043A\u0430\u043A
    \u0430\u043B\u044C\u0444\u0430! \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0430
    \u0432\u043F\u0438\u0441\u043A\u0438 \u043E\u043D \u043C\u0435\u043D\u044F \u043D\u0435
    \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u043B. \u0420\u0430\u0437\u044A\u0435\u0431\u0430\u0442\u044C
    \u0433\u043E\u0442\u043E\u0432 \u0432\u0441\u0451 \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E
    \u0438 \u043A\u043E\u0433\u043E \u0443\u0433\u043E\u0434\u043D\u043E. \u042F
    \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0441\u0442\u043E \u0432
    \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438! \u041B\u0443\u0447\u0448\u0435
    \u043D\u0435 \u0438\u0433\u0440\u0430\u0439 \u0437\u0430 \u043C\u0435\u043D\u044F!
    \u041B\u0443\u0447\u0448\u0435 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438
    \u043D\u0430 \u0442\u0443\u0441\u0443 \u0438\u043B\u0438 \u043D\u0430\u043A\u0438\u043D\u044C
    \u0433\u043E\u043B\u0434\u044B!"
