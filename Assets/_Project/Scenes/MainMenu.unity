    charactersPerSecond: 26
    typewriter: 1
    glitch: 0
    style: 0
  - mainText: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F..."
    secondaryText: "\u041F\u041E\u0412\u0420\u0415\u0416\u0414\u0401\u041D\u041D\u0410\u042F
      \u0417\u0410\u041F\u0418\u0421\u042C"
    duration: 2.55
    fadeIn: 0.35
    fadeOut: 0.28
    charactersPerSecond: 24
    typewriter: 1
    glitch: 0
    style: 0
  - mainText: "...\u0437\u043D\u0430\u0447\u0438\u0442 \u043C\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438."
    secondaryText: "\u041F\u041E\u0412\u0420\u0415\u0416\u0414\u0401\u041D\u041D\u0410\u042F
