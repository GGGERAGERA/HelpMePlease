    "testProfile": { "type": "string", "enum": ["static", "golden-path", "onboarding", "localization", "combat", "events", "rewards", "boss", "core", "placement", "orbital-control", "orbital-tactics", "orbital-placement", "orbital-modules", "orbital-sandbox", "live-visual"] },
